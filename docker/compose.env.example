# Copy this file to .env alongside compose.yaml.
# Use your actual browser address, without a path or trailing slash.
SITE_URL=http://localhost:8081
WEB_PORT=8081
IMAGE_TAG=latest

# Generate separate hexadecimal values: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_random_hex
REDIS_PASSWORD=replace_with_another_random_hex
NATS_PASSWORD=replace_with_another_random_hex
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
ALTCHA_HMAC_SECRET=replace_with_at_least_32_random_characters
CRON_SECRET=replace_with_at_least_32_random_characters
DB_MAX_CONNECTIONS=10

# AI: configure either DeepSeek or Alibaba. Keep unused keys empty.
LLM_PROVIDER=
DEEPSEEK_API_KEY=
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Email verification is required for password-based registration and login.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional administrator allowlists. These do not create accounts.
ADMIN_EMAILS=
ADMIN_USER_IDS=

# Optional GitHub OAuth application credentials; these are not a GitHub PAT.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SPONSORSHIP_PROVIDER=disabled
SPONSORSHIP_FULFILLMENT_ENABLED=false
